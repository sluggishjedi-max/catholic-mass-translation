rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the project's existing access for the public app and local editors.
    match /{collection}/{document=**} {
      allow read, create, update: if !(collection in [
        'daily_mass', 'daily_mass_jobs', 'daily_mass_runs', 'daily_mass_system'
      ]);
    }

    // Only the authenticated server API writes collector/editor data. Version
    // history, original responses, job state and editor identities stay private.
    match /daily_mass/{day} {
      allow read: if true;
      match /records/{record} {
        allow read: if true;
      }
    }

    // Each editor replaces its collection, including removing obsolete entries.
    match /{collection}/{document} {
      allow delete: if collection in [
        'prayer_data',
        'hymn_data',
        'order_of_mass',
        'country_mass_metadata',
        'country_special_liturgies'
      ];
    }
  }
}
